extends SceneTree
## DEV TOOL: data-driven difficulty curve. For every level it measures, with the real rules:
##  par (proven shortest solution), tray/capacity/free-slot pressure, mean legal moves (branching),
##  and the win rate of a random-move bot (low = many traps = harder / needs planning).
##  godot --headless --path . --script res://tools/difficulty_report.gd [-- out.md [rollouts]]
## Deterministic (seeded). Writes a markdown table and prints a summary.

func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	var out_path: String = args[0] if args.size() > 0 else "res://docs/DIFFICULTY.md"
	var rollouts: int = int(args[1]) if args.size() > 1 else 400
	var lib: Node = load("res://src/core/level_library.gd").new()
	lib.load_campaign("res://levels/campaign.json")
	var rows: Array = []
	for lv in lib.levels:
		rows.append(_measure(lv, rollouts))
	var md := PackedStringArray()
	md.append("# Difficulty report\n")
	md.append("Generated by `tools/difficulty_report.gd` from the real rules (%d random-bot rollouts per level, seeded; deterministic)." % rollouts)
	md.append("`random win %` = share of games a bot choosing uniformly random legal moves wins within the level's limits (lower = more traps).")
	md.append("`score` = par × (1 + 2 × (1 − random win)) — a single number for ordering; compare *within* a stage.\n")
	md.append("`trap win %` = same bot with the move limit ignored (shows how trap-heavy the *layout* is, separate from limit tightness).\n")
	md.append("| Lv | Stage | Name | Trays | Types | Free slots | Par | Limit | Avg legal moves | Random win % | Trap win % | Score |")
	md.append("|---:|------:|------|------:|------:|-----------:|----:|------:|----------------:|-------------:|-----------:|------:|")
	for r in rows:
		md.append("| %d | %d | %s | %d | %d | %d | %d | %s | %.1f | %.0f | %.0f | %.0f |" % [r["id"], r["stage"], r["name"], r["trays"], r["types"], r["free"], r["par"], str(r["limit"]) if r["limit"] > 0 else "–", r["branch"], r["rand_win"] * 100.0, r["free_win"] * 100.0, r["score"]])
	var f := FileAccess.open(out_path, FileAccess.WRITE)
	f.store_string("\n".join(md) + "\n")
	f.close()
	var by_stage := {}
	for r in rows:
		if not by_stage.has(r["stage"]):
			by_stage[r["stage"]] = []
		by_stage[r["stage"]].append(r)
	for st in by_stage:
		var sc := 0.0
		var rw := 0.0
		for r in by_stage[st]:
			sc += r["score"]
			rw += r["rand_win"]
		print("stage %d: %d levels, mean score %.0f, mean random win %.0f%%" % [st, by_stage[st].size(), sc / by_stage[st].size(), 100.0 * rw / by_stage[st].size()])
	print("wrote ", out_path)
	lib.free()
	quit()


func _measure(lv: Dictionary, rollouts: int) -> Dictionary:
	var base := BoardState.from_level(lv)
	var par: int = (lv["solution"] as Array).size()
	var rng := RandomNumberGenerator.new()
	rng.seed = 1000 + int(lv["id"])
	var wins := 0
	var free_wins := 0
	var branch_sum := 0.0
	var branch_n := 0
	for k in rollouts:
		var b := base.clone()
		var steps := 0
		while steps < 400:
			if b.is_won():
				wins += 1
				break
			var lm := b.legal_moves()
			if lm.is_empty() or (b.max_moves > 0 and b.moves >= b.max_moves):
				break
			if k < 20:
				branch_sum += lm.size()
				branch_n += 1
			var mv: Array = lm[rng.randi() % lm.size()]
			b.apply_move(mv[0], mv[1])
			steps += 1
	# same bot, move limit removed: measures layout traps independent of limit tightness
	var nolimit := base.clone()
	nolimit.max_moves = 0
	for k in rollouts:
		var b2 := nolimit.clone()
		var st := 0
		while st < 400:
			if b2.is_won():
				free_wins += 1
				break
			var lm2 := b2.legal_moves()
			if lm2.is_empty():
				break
			var mv2: Array = lm2[rng.randi() % lm2.size()]
			b2.apply_move(mv2[0], mv2[1])
			st += 1
	var rw := float(wins) / float(rollouts)
	return {"id": int(lv["id"]), "stage": int(lv["stage"]), "name": str(lv["name"]), "trays": base.tray_count(), "types": int(lv["types"]),
		"free": base.free_slots(), "par": par, "limit": int(lv.get("max_moves", 0)), "branch": branch_sum / maxf(1.0, float(branch_n)),
		"rand_win": rw, "free_win": float(free_wins) / float(rollouts), "score": par * (1.0 + 2.0 * (1.0 - rw))}
